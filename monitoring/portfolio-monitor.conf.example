# Конфиг портфельной опрашивалки. Кладётся в /root/monitoring/portfolio-monitor.conf
# с правами 0600. Установщик (install-portfolio-monitor.sh) создаёт его сам и пишет
# туда только значения, свои у хоста; всё остальное — значения по умолчанию в скрипте.
# Ниже — оба профиля; на хосте оставить свой.
#
# Токен VK на хосте держим ОДНОЙ копией: подтягиваем его из конфига соседнего
# монитора через VK_CONF_FILE, а не заводим вторую. При ротации менять одно место.

# Роль обязательна: без неё «TARGETS_FILE потерялся» неотличимо от «целей и не
# должно быть», и внешняя опрашивалка молча становится зелёным no-op'ом.
ROLE=external

VK_CONF_FILE=/root/monitoring/monitor.conf

# --- Значения по умолчанию (менять только осознанно, только числами) ---------
# STATE_DIR — только абсолютный путь, без пробелов и знака %: из такого пути
# строка cron обрывается молча (в поле команды % означает перевод строки).
# Установщик на негодном значении останавливается — кроме случая, когда взведён
# выключатель: тогда он предупреждает, снимает строку и берёт каталог по умолчанию.
# STATE_DIR=/var/lib/portfolio-monitor
# LOG_FILE=/var/log/portfolio-monitor.log
# CERT_WARN_DAYS=21
# SLOW_MS=10000
# RETRY_DELAY=10
# HEARTBEAT_HOUR=6
#
# Молчание пира дольше этого — сигнал. 1800 с = шесть пропущенных прогонов при
# cron */5, с запасом на худший прогон стейджа.
# PEER_SILENCE_SEC=1800
#
# Пока пир ни разу не выходил на связь, «маячка нет» пишется в лог и в пульс, но
# тревогу не поднимает: при выкатке одна сторона встаёт раньше другой. 48 ч —
# запас на ручной прод-деплой после мержа. Сломанный ssh-ключ льготой не
# прикрыт: его сразу выдаёт доставка своего маячка.
# PEER_FIRST_CONTACT_GRACE_SEC=172800
#
# Бюджет прогона. Сетевые операции укладываются в RUN_BUDGET_SEC − SEND_RESERVE_SEC;
# если цели съели этот запас, после него остаются не больше двух отправок в VK по 15 с
# (пробная отправка при исчерпанном бюджете пропускается всегда, пульс — только если в
# прогоне уже что-то ушло). Сумма обязана быть меньше `timeout 280` в строке cron:
# при 260/40 это 220 + 30 = 250 с. Сам потолок задавать здесь НЕЛЬЗЯ: его приносит
# строка cron, которую пишет установщик, — иначе этим конфигом можно было бы отключить
# проверку, которая его же и сторожит. Боевым считается бюджет от 60 с; при нём скрипт
# считает конфиг сломанным, если резерв меньше 30 с (берёт 40), если на проверки не
# остаётся и 30 с или если сумма не умещается в потолок (берёт пару, выведенную из него).
# Значения — целыми числами; ведущий ноль допустим и нормализуется (`06` — это 6).
# RUN_BUDGET_SEC=260
# SEND_RESERVE_SEC=40
#
# Пробная отправка при сломанном канале алертов — не чаще этого.
# PROBE_INTERVAL_SEC=1800
#
# Файл-выключатель: пока он лежит, опрашивалка при запуске сразу выходит.
# DISABLED_FLAG=/root/monitoring/portfolio-monitor.disabled

# =====================================================================
# ПРОФИЛЬ 1 — стейдж (185.244.172.45): внешний взгляд на портфель.
# Смотрит на прод СНАРУЖИ наблюдаемой машины, читает маячок прода по ssh
# и доставляет проду свой тем же ключом, которым ходит offsite-бэкап.
# =====================================================================
# Файл целей берётся из рабочей копии репозитория, а не из копии рядом с конфигом:
# так список целей обновляется деплоем, а не застывает на дне установки.
# TARGETS_FILE=/root/todo/monitoring/portfolio-targets.conf
# PEER_TRANSPORT=ssh
# PEER_LABEL=прод
# PEER_HOST=82.114.226.107
# PEER_SSH_KEY=/root/.ssh/id_ed25519_backup

# =====================================================================
# ПРОФИЛЬ 2 — прод (82.114.226.107): сторож над стейджем.
# Целей не опрашивает (это работа стейджа — наблюдатель не должен жить
# внутри наблюдаемого), но сторожит стейдж, сверяет серты в эфире с диском,
# сверяет root-owned копию скриптов с репозиторием и следит, что продление
# сертификатов отрабатывает.
# Маячок стейджа кладёт сам стейдж, поэтому транспорт local.
# =====================================================================
# ROLE=peer
# PEER_TRANSPORT=local
# PEER_LABEL=стейдж
# COPY_DRIFT_CHECK="/root/monitoring:/home/deploy/todo/monitoring"
#
# Для роли peer включены по умолчанию, в конфиг их писать не нужно:
# CERT_DRIFT_DOMAINS=auto   — все серты из /etc/letsencrypt/live контейнера certbot
# RENEW_OK_FILE=<STATE_DIR>/certbot-renew.ok
# Выключить их из конфига нельзя: пустое значение считается незаданным и заменяется
# умолчанием. Выключать опрашивалку целиком — файлом-выключателем.
