# Конфиг портфельной опрашивалки. Кладётся в /root/monitoring/portfolio-monitor.conf
# с правами 0600. Ниже — оба профиля; на хосте оставить свой.
#
# Токен VK на хосте держим ОДНОЙ копией: подтягиваем его из конфига соседнего
# монитора через VK_CONF_FILE, а не заводим вторую. При ротации менять одно место.

# Роль обязательна: без неё «TARGETS_FILE потерялся» неотличимо от «целей и не
# должно быть», и внешняя опрашивалка молча становится зелёным no-op'ом.
ROLE=external

VK_CONF_FILE=/root/monitoring/monitor.conf

STATE_DIR=/var/lib/portfolio-monitor
LOG_FILE=/var/log/portfolio-monitor.log
ALERT_PREFIX=[portfolio]

CERT_WARN_DAYS=21
SLOW_MS=10000
RETRY_DELAY=10
HEARTBEAT_HOUR=6

# Молчание пира дольше этого — сигнал. 1800 с = шесть пропущенных прогонов при
# cron */5. Порог с запасом потому, что худший прогон стейджа (девять целей,
# полная сетевая недоступность, ретраи) идёт дольше пятиминутного окна, и
# промежуток между маячками в такие моменты растягивается.
PEER_SILENCE_SEC=1800

# =====================================================================
# ПРОФИЛЬ 1 — стейдж (185.244.172.45): внешний взгляд на портфель.
# Смотрит на прод СНАРУЖИ наблюдаемой машины, читает маячок прода по ssh
# и доставляет проду свой тем же ключом, которым ходит offsite-бэкап.
# =====================================================================
# Файл целей берётся из рабочей копии репозитория, а не из копии рядом с конфигом:
# так список целей обновляется деплоем, а не застывает на дне установки.
# TARGETS_FILE=/root/todo/monitoring/portfolio-targets.conf
# PEER_TRANSPORT=ssh
# PEER_LABEL=прод
# PEER_HOST=82.114.226.107
# PEER_SSH_USER=root
# PEER_SSH_KEY=/root/.ssh/id_ed25519_backup
# PEER_STATE_DIR=/var/lib/portfolio-monitor

# =====================================================================
# ПРОФИЛЬ 2 — прод (82.114.226.107): сторож над стейджем.
# Целей не опрашивает (это работа стейджа — наблюдатель не должен жить
# внутри наблюдаемого), но сторожит стейдж и сверяет серты в эфире с диском.
# Маячок стейджа кладёт сам стейдж, поэтому транспорт local.
# =====================================================================
# PEER_TRANSPORT=local
# PEER_LABEL=стейдж
# CERT_DRIFT_DOMAINS="todo.keepware.ru todo.mngerasimenko.ru keepware.ru vpscan.keepware.ru clickmebattle.keepware.ru clickmebattle.mngerasimenko.ru api.replyai.keepware.ru"
# CERTBOT_CONTAINER=certbot
