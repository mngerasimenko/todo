# Канал алертов — VK. Отсюда токен берут server-monitor.sh, stats-report.sh и
# vk-bot.sh (сорсят этот файл рядом с собой), portfolio-monitor.sh и соседняя
# проба replyAI (через VK_CONF_FILE). Копий этого файла на проде две — рядом со
# скриптами в /home/deploy/todo/monitoring и в /root/monitoring; полный список
# мест, где лежит токен, и порядок ротации — в README, раздел «Обращение с
# секретами». Файл держим в правах 600: в нём секрет.
VK_TOKEN="your-vk-group-token-here"
VK_PEER_ID="your-vk-peer-id-here"
VK_GROUP_ID="your-vk-group-id-here"
VK_API_VERSION="5.199"

# Legacy Telegram: с российских хостов заблокирован, не используется.
TELEGRAM_BOT_TOKEN="your-bot-token-here"
TELEGRAM_CHAT_ID="your-chat-id-here"

# Alert thresholds
RAM_WARN=80        # % RAM usage
SWAP_WARN=50       # % Swap usage
DISK_WARN=85       # % Disk usage
JVM_HEAP_WARN=85   # % JVM Heap usage (via Actuator)

# Alert cooldown (seconds) - don't repeat same alert within this period
ALERT_COOLDOWN=1800

# Где server-monitor.sh держит отметки кулдауна. По умолчанию
# /var/lib/server-monitor/alert-state — каталог, куда пишет только root:
# в общем /tmp чужой пользователь мог бы заглушить алерт заранее положенной
# отметкой. Переопределять стоит только в тестах.
#ALERT_STATE_FILE=/var/lib/server-monitor/alert-state

# Таймаут запроса к VK в секундах (vk-send.sh), по умолчанию 15.
#VK_TIMEOUT=15

# Ручки Long Poll у бота (vk-bot.sh). Значения по умолчанию подходят; нечисловое
# значение игнорируется, берётся умолчание — иначе оно молча выключало бы потолок.
# VK_LP_DEAD_AFTER   - секунд без удачного опроса до выхода, чтобы systemd увёл
#                      юнит в failed (120)
# VK_LP_MAX_FAILURES - неудач подряд до перевыпуска сессионного ключа (5)
# VK_LP_RETRY_SLEEP  - пауза между попытками подключения, секунды (10)
# VK_LP_POLL_SLEEP   - пауза между неудачными опросами, секунды (2)
# Потолки: VK_LP_DEAD_AFTER обрезается до 150, VK_LP_RETRY_SLEEP до 30,
# VK_LP_POLL_SLEEP до 10. Под них посчитано окно StartLimitIntervalSec=1500 в
# юните бота: худшая попытка = DEAD_AFTER + (RETRY_SLEEP + 50) + RestartSec, и
# пять таких попыток обязаны уместиться в окно, иначе юнит не дойдёт до failed.
#VK_LP_DEAD_AFTER=120

# Containers to monitor
MONITOR_CONTAINERS="todo-app postgres-db nginx-proxy todo-web"

# Offsite backup settings (used by offsite-backup.sh)
PRODUCTION_SERVER="your-production-ip-here"
SSH_KEY="/root/.ssh/id_ed25519_backup"
