#!/usr/bin/env bash
# Заглушка python3. Нужна не для скорости: в Git Bash под Windows на PATH лежит
# заглушка магазина приложений, которая печатает «Python» и выходит с нулём, —
# набор без подмены молча проверял бы не то.
#
# Разбирается не питон, а те несколько выражений, которые скрипты мониторинга
# в него передают: их опознаём по тексту программы (аргумент после -c).

prog=""
want_prog=0
for a in "$@"; do
  if [ "$want_prog" = "1" ]; then prog="$a"; want_prog=0; continue; fi
  [ "$a" = "-c" ] && want_prog=1
done

input="$(cat)"

# JSON-поле верхнего уровня или внутри "response" — строкой, без вложенности.
field() {
  printf '%s' "$input" | sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\{0,1\}\([^\",}]*\)\"\{0,1\}.*/\1/p" | head -1
}

case "$prog" in
  *measurements*)
    # jvm.memory.* — число в экспоненциальной записи приводим к целому.
    printf '%s' "$input" | sed -n 's/.*"value":\([0-9.eE+-]*\).*/\1/p' | head -1 \
      | awk '{ printf "%d\n", $1 }'
    ;;
  *Статистика*)
    # stats-report.sh: текст сводки. Содержимое для проверки отправки не важно,
    # важно, что оно непустое и многострочное — как настоящее.
    printf '%s\n' '📈 Статистика (за 24ч)'
    printf '%s\n' ''
    printf '%s\n' '👥 Пользователи: 7 (новых: 1 — тест)'
    ;;
  *"'server'"*) field server ;;
  *"'key'"*)    field key ;;
  *"'ts'"*)     field ts ;;
  *"'failed'"*) printf '%s\n' '0' ;;
  *updates*)    printf '%s\n' '0' ;;
  *)            printf '%s\n' '' ;;
esac
exit 0
