#!/usr/bin/env bash
# Заглушка chmod: при STUB_CHMOD_NOOP=1 ничего не делает. Так тест воспроизводит
# каталог, смонтированный без права исполнения, где `chmod +x` бит не выставляет.
#
# Вызовы записываются в $STUB_STATE/chmod.argv: под Windows файловые права не
# меняются вовсе (chmod 600 оставляет 644), и проверить сужение прав конфига по
# итоговому режиму там нечем — а по факту вызова можно везде.
[ -n "${STUB_STATE:-}" ] && printf '%s\n' "$*" >> "${STUB_STATE}/chmod.argv"
[ "${STUB_CHMOD_NOOP:-0}" = "1" ] && exit 0
exec /usr/bin/chmod "$@"
