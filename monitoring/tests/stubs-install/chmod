#!/usr/bin/env bash
# Заглушка chmod: при STUB_CHMOD_NOOP=1 ничего не делает. Так тест воспроизводит
# каталог, смонтированный без права исполнения, где `chmod +x` бит не выставляет.
#
# Вызовы записываются в $STUB_STATE/chmod.argv: под Windows файловые права не
# меняются вовсе (chmod 600 оставляет 644), и проверить сужение прав конфига по
# итоговому режиму там нечем — а по факту вызова можно везде.
[ -n "${STUB_STATE:-}" ] && printf '%s\n' "$*" >> "${STUB_STATE}/chmod.argv"
[ "${STUB_CHMOD_NOOP:-0}" = "1" ] && exit 0
# STUB_CHMOD_SWAP: сразу после chmod путь подменяется другим объектом — так
# воспроизводится гонка, ради которой установщик перечитывает тип файла.
# Предотвратить подмену в sh нечем (chmod без O_NOFOLLOW), поэтому проверяется
# именно то, что её ВИДНО. Подменяем каталогом, а не симлинком: симлинки в Git
# Bash под Windows не создаются, а каталог одинаково ловится проверкой `-f`.
# Только сужение прав самого конфига с токеном: установщик зовёт chmod ещё для
# `+x` на своих скриптах и для временного файла конфига опрашивалки, и подмена
# там сломала бы установку задолго до места, которое сценарий проверяет.
if [ -n "${STUB_CHMOD_SWAP:-}" ] && [ "$1" = "600" ]; then
  /usr/bin/chmod "$@"
  rc=$?
  for last in "$@"; do :; done
  case "$last" in
    *monitor.conf)
      if [ -f "$last" ]; then
        rm -f "$last"
        mkdir -p "$last"
      fi
      ;;
  esac
  exit "$rc"
fi
exec /usr/bin/chmod "$@"
