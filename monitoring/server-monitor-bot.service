[Unit]
Description=VK Server Monitor Bot
After=network-online.target docker.service
Wants=network-online.target
# Потолок рестартов — в [Unit], иначе systemd его не читает. Без него бот,
# которому нечем работать (нет vk-send.sh, нет конфига, отозван токен),
# перезапускался бы вечно и выглядел бы в systemctl живым.
#
# Окно считано под худший случай выхода самого бота. Стартовые проверки падают
# мгновенно: пять стартов по RestartSec=10 укладываются в 50 с. Мёртвый Long
# Poll бот держит VK_LP_DEAD_AFTER (по умолчанию 120 с) плюс один незавершённый
# запрос (до 35 с), то есть около 165 с на попытку; чтобы пять таких попыток
# уместились в окно, оно и взято с запасом — 900 с. Считать неудачи по времени,
# а не по числу попыток, пришлось именно поэтому: при заблокированном адресе
# каждая попытка стоит таймаута curl, и в окно 300 с пять рестартов не помещались
# никогда — юнит вечно оставался active.
StartLimitIntervalSec=900
StartLimitBurst=5

[Service]
# Юнит на проде запускает именно этот файл (сверено 21.09.2026 по systemctl cat).
# В репозитории до сих пор стоял telegram-bot.sh — Telegram с российских хостов
# заблокирован, и пересборка хоста по git подняла бы мёртвый бот, молчащий ровно
# так же, как исправный.
#
# Каталог важен: рядом с vk-bot.sh должны лежать monitor.conf и vk-send.sh —
# бот сорсит оба и без них выходит с 1.
Type=simple
ExecStart=/bin/bash /home/deploy/todo/monitoring/vk-bot.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
