[Unit]
Description=VK Server Monitor Bot
After=network-online.target docker.service
Wants=network-online.target
# Потолок рестартов — в [Unit], иначе systemd его не читает. Без него бот,
# которому нечем работать (нет vk-send.sh, нет конфига, отозван токен),
# перезапускался бы вечно и выглядел бы в systemctl живым.
#
# Окно считано под ХУДШУЮ жизнь процесса, а не под типичную. Бот проверяет
# живость после возврата запроса, поэтому между двумя проверками может пройти
# пауза переподключения плюс два таймаута curl (15 с у вызова метода, 35 с у
# опроса). Отсюда попытка = VK_LP_DEAD_AFTER + (VK_LP_RETRY_SLEEP + 50) +
# RestartSec. Ручки ограничены сверху в самом боте (150 / 30 / 10), значит
# худшая попытка — 150 + 80 + 10 = 240 с, пять попыток — 1200 с. Окно взято 1500,
# чтобы оставался запас; при умолчаниях (120 и 10) попытка равна 190 с.
#
# Считать неудачи по времени, а не по числу попыток, пришлось потому, что каждая
# попытка стоит таймаута curl: при заблокированном адресе в прежнее окно 300 с
# пять рестартов не помещались никогда — юнит вечно оставался active.
StartLimitIntervalSec=1500
StartLimitBurst=5

[Service]
# Юнит на проде запускает именно этот файл (сверено 21.09.2026 по systemctl cat).
# В репозитории до сих пор стоял telegram-bot.sh — Telegram с российских хостов
# заблокирован, и пересборка хоста по git подняла бы мёртвый бот, молчащий ровно
# так же, как исправный.
#
# Каталог важен: рядом с vk-bot.sh должны лежать monitor.conf и vk-send.sh —
# бот сорсит оба и без них выходит с 1.
Type=simple
ExecStart=/bin/bash /home/deploy/todo/monitoring/vk-bot.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
