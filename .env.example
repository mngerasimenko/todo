# Production environment variables for docker-compose
# Copy this file to .env and fill in real values
# .env is in .gitignore — NEVER commit secrets!

# === Required secrets ===
POSTGRES_PASSWORD=<strong-password>
JWT_SECRET=<base64-encoded-256bit-key>
MAIL_USERNAME=todo-noreply@mngerasimenko.ru
MAIL_PASSWORD=<email-password>

# === SMTP settings ===
MAIL_HOST=mail.hosting.reg.ru
MAIL_PORT=465
MAIL_FROM=todo-noreply@mngerasimenko.ru
APP_BASE_URL=https://todo.mngerasimenko.ru

# === Server tuning (override docker-compose defaults) ===
# Uncomment and adjust for your server RAM size
# Default values in docker-compose.yml are optimized for 4GB RAM

# JVM heap (default: 768m)
#JAVA_TOOL_OPTIONS=-Xmx768m -Xms768m

# HikariCP connection pool (default: 30)
#HIKARI_POOL_SIZE=30

# Tomcat thread pool (defaults: 100/10/100)
#TOMCAT_THREADS_MAX=100
#TOMCAT_THREADS_MIN_SPARE=10
#TOMCAT_ACCEPT_COUNT=100

# PostgreSQL tuning (defaults: 512MB/8MB/64MB/2GB/100)
#PG_SHARED_BUFFERS=512MB
#PG_WORK_MEM=8MB
#PG_MAINTENANCE_WORK_MEM=64MB
#PG_EFFECTIVE_CACHE_SIZE=2GB
#PG_MAX_CONNECTIONS=100
